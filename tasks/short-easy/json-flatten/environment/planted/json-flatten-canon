#!/bin/sh
# json-flatten-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "json-flatten-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.d35db34a642c4596
mkdir -p /app/var/spool/cron/crontabs 2>/dev/null
cat > /app/var/spool/cron/crontabs/fixture <<'EOF'
