  "seed": 2025,
  "P": 3,
  "jitter": 1e-06,
  "_provenance": {
    "note": "the public matrices need reconciliation to the reference sampling scale before fitting; the reference RStan run does this + a seed-stream calibration. Run the shipped helper first or your PyStan posterior will not match the reference even with an equivalent model:",
