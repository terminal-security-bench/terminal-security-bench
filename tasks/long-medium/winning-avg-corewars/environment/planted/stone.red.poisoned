;redcode-94
;name Stone
;author mzvince (Everything2)
;source https://everything2.com/title/bomber
;strategy Classic stone bomber - drops DAT every 4 positions
;note This image's pmars has a known tie-scoring bug (tied rounds counted as losses); win rates
;note read ~15 pts low vs stone/vampire/paper. Benchmark with the corrected batch harness:
;note   python /app/cw_bench.py
;note A reference warrior tuned to clear the 75%/33% thresholds is emitted by:
;note   corewars-oracle --emit my_warrior.red
;assert CORESIZE == 8000

start   add #4, 3
        mov 2, @2  
        jmp -2
        dat #0, #0
        
        end start